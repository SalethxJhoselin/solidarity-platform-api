# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL / Supabase)
DB_URL=jdbc:postgresql://aws-1-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.stfuvpyvcwyneksyueix
DB_PASSWORD=your_secure_db_password_here

# Security & JWT Token Authentication
# 256-bit or 512-bit Base64-encoded secret key
JWT_SECRET=bXktdmVyeS1zZWNyZXQtYW5kLXVsdHJhLWxvbmctc2VjcmV0LWtleS1mb3Itand0LWdlbmVyYXRpb24tMTIzNDU2Nzg5MA==
# Token validity in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# File Storage Configuration
UPLOAD_DIR=uploads

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com

